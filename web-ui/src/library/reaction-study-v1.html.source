<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Reaction Bar · 独立交互研究 v1</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#fff;color:#252525;font:15px/1.5 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}main{max-width:760px;margin:50px auto;padding:0 22px}h1{font-size:18px;font-weight:500;margin:0 0 14px}.stage{height:420px;border:1px solid #ddd;border-radius:20px;display:flex;align-items:center;justify-content:center;padding:25px 18px}.row{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;max-width:100%}button{font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}button:focus-visible{outline:3px solid #303030;outline-offset:4px}.reaction,.add{border:0;background:#f3f3f3;border-radius:999px;height:48px;min-width:82px;display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:0 14px;color:#777;transition:background .16s,color .16s,box-shadow .16s;touch-action:manipulation}.reaction[aria-pressed=true]{background:#0784ff;color:white}.reaction:hover{box-shadow:inset 0 0 0 1px #0000000b}.emoji{font-size:23px;line-height:1}.count{font-size:19px;font-variant-numeric:tabular-nums}.add{min-width:48px;width:48px;padding:0;color:#818181}.add svg{width:25px;height:25px}.tip{position:fixed;z-index:3;border-radius:999px;padding:5px 14px 5px 6px;background:#303030;color:white;font-size:16px;box-shadow:0 4px 12px #0001;display:flex;gap:7px;align-items:center;max-width:calc(100vw - 16px);pointer-events:none}.tip[hidden],.picker[hidden],.people[hidden]{display:none}.avatar{display:inline-grid;place-items:center;width:29px;height:29px;border:2px solid white;border-radius:50%;background:#d4e5ec;color:#344951;font-size:10px;font-weight:700;flex-shrink:0}.avatar:nth-child(2){background:#e7d9f0}.picker{position:fixed;z-index:4;padding:8px;background:white;border:1px solid #ddd;border-radius:14px;box-shadow:0 8px 30px #0001}.picker button{border:0;background:#f4f4f4;border-radius:9px;padding:10px 14px}.controls{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin:18px 0 12px}.textbtn{border:0;background:transparent;padding:5px 0;color:#686868;font-size:13px;text-decoration:underline;text-underline-offset:3px}.people{padding:12px 15px;background:#f7f7f7;border-radius:12px;margin-bottom:14px;font-size:13px}.note{font-size:12px;color:#888;line-height:1.8;margin-top:24px}a{color:inherit}summary{cursor:pointer}.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:480px){main{margin-top:28px;padding:0 16px}.stage{height:340px;padding:24px 12px}.row{gap:7px}.reaction{min-width:65px;padding:0 10px;gap:8px}.emoji{font-size:21px}.count{font-size:17px}.add{width:44px;min-width:44px}.note{font-size:11px}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style><main><h1>Reaction Bar ⋆｡°✩</h1><section class="stage" aria-label="反应栏交互研究"><div class="row" role="group" aria-label="消息反应"></div></section>
<div id="tooltip" class="tip" role="tooltip" hidden></div><div id="picker" class="picker" role="group" aria-label="添加反应" hidden><button id="fire">🔥 添加火焰反应</button></div>
<div class="controls"><button class="textbtn" id="demo" aria-pressed="false">播放演示</button><button class="textbtn" id="reset">重置</button><button class="textbtn" id="details" aria-expanded="false" aria-controls="people">查看参与者</button><label style="font-size:12px;color:#777"><input type="checkbox" id="reduce"> 减少动态</label><span id="status" class="sr" aria-live="polite"></span></div><div id="people" class="people" hidden></div>
<details class="note"><summary>独立研究复现 v1 · 来源与边界</summary><p>参考 <a href="https://x.com/pmalay694/status/2116126061977280978" target="_blank" rel="noopener">Malay 的 Reaction Bar 原视频</a>；非作者原码、非逐像素或轨迹精确复刻。<a href="https://x.com/pmalay694/status/2116143716960473265" target="_blank" rel="noopener">作者说明</a>真实使用会给 tooltip 加短延迟。</p><p>根据原帧还原胶囊层级、蓝色选中与悬浮姓名。此版主动选择：悬停延迟 300ms、重排 220ms、自动演示步长 1.8s；原视频精确参数未知。头像是通用字母示例，不是原作者艺术素材。键盘/触屏与减少动态效果是本研究补充，未暗示上游已支持。仅本地示例，无联网请求或真实消息写入；未获审美入库批准。</p></details></main>
<script>
(()=>{'use strict';const row=document.querySelector('.row'),tip=document.querySelector('#tooltip'),picker=document.querySelector('#picker'),people=document.querySelector('#people'),status=document.querySelector('#status');const reduced=matchMedia('(prefers-reduced-motion: reduce)');const defs=[{id:'like',emoji:'👍',label:'赞',base:3,names:['Sam','Noor','Jonah']},{id:'celebrate',emoji:'🎉',label:'庆祝',base:2,names:['Sam','Noor']},{id:'eyes',emoji:'👀',label:'关注',base:1,names:['Jonah']},{id:'fire',emoji:'🔥',label:'火焰',base:0,names:[]}];let selected=new Set(['like']),timer=null,auto=null,step=0,anchor=null;const add=document.createElement('button');add.className='add';add.setAttribute('aria-label','添加反应');add.setAttribute('aria-expanded','false');add.innerHTML='\x3csvg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">\x3cpath d="M19.6 11A8 8 0 1 0 11 20M7 13s1.5 2 5 2M8.5 8.5h.01M14.5 8.5h.01" stroke-linecap="round"/>\x3cpath d="M18 14v8m-4-4h8"/>\x3c/svg>';const buttons=new Map();row.append(add);
function hideTip(){clearTimeout(timer);tip.hidden=true;for(const b of buttons.values())b.removeAttribute('aria-describedby');anchor=null}function place(el,b){const r=b.getBoundingClientRect(),s=el.getBoundingClientRect();el.style.left=Math.max(8,Math.min(innerWidth-s.width-8,r.left+r.width/2-s.width/2))+'px';el.style.top=Math.max(8,r.top-s.height-14)+'px'}function names(d){return [...d.names,...(selected.has(d.id)?['你']:[])]}function showTip(d,b){hideTip();anchor=b;tip.replaceChildren();for(const n of names(d).slice(0,2)){const a=document.createElement('span');a.className='avatar';a.textContent=n==='你'?'你':n.slice(0,1);a.setAttribute('aria-hidden','true');tip.append(a)}const text=document.createElement('span');text.textContent=names(d).join('、');tip.append(text);tip.hidden=false;b.setAttribute('aria-describedby','tooltip');place(tip,b)}function closePicker(){picker.hidden=true;add.setAttribute('aria-expanded','false')}function refreshPeople(){people.textContent=defs.filter(d=>d.base+Number(selected.has(d.id))>0).map(d=>d.emoji+' '+names(d).join('、')).join('　 ·　 ')}function render(){hideTip();const old=new Map([...buttons].map(([id,b])=>[id,b.getBoundingClientRect()]));const focus=document.activeElement;for(const d of defs){let b=buttons.get(d.id);const count=d.base+Number(selected.has(d.id));if(!count){if(b){b.remove();buttons.delete(d.id);if(focus===b)add.focus()}continue}if(!b){b=document.createElement('button');b.className='reaction';b.dataset.id=d.id;b.innerHTML='\x3cspan class="emoji" aria-hidden="true">\x3c/span>\x3cspan class="count" aria-hidden="true">\x3c/span>';b.addEventListener('click',()=>{stopDemo();toggle(d.id)});b.addEventListener('pointerenter',e=>{if(e.pointerType==='touch')return;timer=setTimeout(()=>showTip(d,b),300)});b.addEventListener('pointerleave',hideTip);b.addEventListener('focus',()=>showTip(d,b));b.addEventListener('blur',hideTip);buttons.set(d.id,b)}b.querySelector('.emoji').textContent=d.emoji;b.querySelector('.count').textContent=count;b.setAttribute('aria-pressed',String(selected.has(d.id)));b.setAttribute('aria-label',`${d.label}，${count} 人，${selected.has(d.id)?'取消':'添加'}我的反应`);if(b.parentElement!==row)row.insertBefore(b,add)}if(!reduced.matches&&!document.querySelector("#reduce").checked)for(const [id,b] of buttons){const prev=old.get(id),now=b.getBoundingClientRect();b.getAnimations().forEach(a=>a.cancel());if(prev)b.animate([{transform:`translate(${prev.left-now.left}px,${prev.top-now.top}px)`},{transform:'translate(0,0)'}],{duration:220,easing:'cubic-bezier(.2,.8,.2,1)'});else b.animate([{opacity:0,transform:'scale(.8)'},{opacity:1,transform:'scale(1)'}],{duration:220})}refreshPeople()}
function toggle(id){selected.has(id)?selected.delete(id):selected.add(id);render();status.textContent=defs.find(d=>d.id===id).label+'反应已'+(selected.has(id)?'添加':'取消')}function stopDemo(){clearInterval(auto);auto=null;document.querySelector('#demo').textContent='播放演示';document.querySelector('#demo').setAttribute('aria-pressed','false')}add.addEventListener('click',()=>{stopDemo();hideTip();if(!picker.hidden){closePicker();return}picker.hidden=false;add.setAttribute('aria-expanded','true');place(picker,add);document.querySelector('#fire').textContent=selected.has('fire')?'🔥 移除火焰反应':'🔥 添加火焰反应';document.querySelector('#fire').focus()});document.querySelector('#fire').onclick=()=>{toggle('fire');closePicker();add.focus()};document.querySelector('#details').onclick=e=>{people.hidden=!people.hidden;e.currentTarget.setAttribute('aria-expanded',String(!people.hidden))};document.querySelector('#reset').onclick=()=>{stopDemo();closePicker();selected=new Set(['like']);render()};document.querySelector('#demo').onclick=()=>{if(auto){stopDemo();return}closePicker();hideTip();document.querySelector('#demo').textContent='暂停演示';document.querySelector('#demo').setAttribute('aria-pressed','true');step=0;auto=setInterval(()=>{const actions=[()=>toggle('fire'),()=>showTip(defs[2],buttons.get('eyes')),()=>toggle('like'),()=>toggle('fire'),()=>toggle('like'),hideTip];actions[step++%actions.length]()},1800)};document.addEventListener('keydown',e=>{if(e.key==='Escape'){hideTip();if(!picker.hidden){closePicker();add.focus()}stopDemo()}});document.addEventListener('pointerdown',e=>{if(!picker.contains(e.target)&&!add.contains(e.target))closePicker()});addEventListener('resize',()=>{hideTip();closePicker()});addEventListener('scroll',hideTip,{passive:true});document.addEventListener('visibilitychange',()=>{if(document.hidden){stopDemo();hideTip()}});document.querySelector('#reduce').onchange=()=>{stopDemo();buttons.forEach(b=>b.getAnimations().forEach(a=>a.cancel()))};reduced.addEventListener('change',()=>{stopDemo();buttons.forEach(b=>b.getAnimations().forEach(a=>a.cancel()))});render();})();
</script></html>
