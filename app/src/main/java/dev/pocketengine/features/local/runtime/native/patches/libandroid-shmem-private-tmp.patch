-#define ASHV_KEY_SYMLINK_PATH _PATH_TMP "ashv_key_%d"
+/* PocketWorld modification, 2026-10-31: no Termux prefix or writable-system tmp.
+ * The launch owner supplies its canonical private PROOT_TMP_DIR. */
+static int ashv_key_path(char *path, size_t size, key_t key)
+{
+	const char *directory = getenv("PROOT_TMP_DIR");
+	if (directory == NULL || directory[0] != '/') {
+		errno = EINVAL;
+		return -1;
+	}
+	int length = snprintf(path, size, "%s/ashv_key_%d", directory, key);
+	if (length < 0 || (size_t)length >= size) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	return 0;
+}
 #define ANDROID_SHMEM_SOCKNAME "/dev/shm/%08x"
