{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pocketworld:pairing:1.0",
  "title": "PocketWorld isolated onboarding messages",
  "description": "One server-auth exact-pin onboarding lane only: max16384 control bytes, no binary, one request/response per connection, 15s/128KiB TLS budget, per-process2 concurrent/12 new connections per minute. Candidate inspection creates neither AuthenticatedPeer nor Permission. Native double-fingerprint confirmation yields PendingPairing pins; separate exact-pin mTLS plus native owner grant is mandatory before one original SQLite commit. Invitation secret is never persisted/logged; only digest/public certificate/transcript/signatures are stored. Business schema remains urn:pocketworld:device:1.0. Already-committed recovery is a distinct native read-only mTLS handle, not PendingPairing and not a business Permission. The original invitation receipt_json atomically stores immutable completion with peer/grant; exact same bytes are recovered without renewing invitation TTL, grant epoch/lifetime or any budget. Current revoke, epoch/scope change or grant expiry denies remote recovery; local historical receipt remains and never asserts current trust. The joiner retains only the original native reviewed public summary/scope in the original candidate table, never the invitation token. Existing CSPRNG one-use inviteId/tokenDigest, both complete identities and platform TLS proof bind the unique transcript; no separate nonce roundtrip or alternate pairing system is introduced.",
  "oneOf": [
    {
      "$ref": "#/$defs/Invitation"
    },
    {
      "$ref": "#/$defs/Candidate"
    },
    {
      "$ref": "#/$defs/CandidateReceipt"
    },
    {
      "$ref": "#/$defs/Finalize"
    },
    {
      "$ref": "#/$defs/Completion"
    }
  ],
  "$defs": {
    "Transcript": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "messageType": {
          "const": "PairingTranscript"
        },
        "inviteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "inviterDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "inviterInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "inviterFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "joinerDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "joinerInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "joinerFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tokenDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "protocolProfile": {
          "type": "string",
          "pattern": "^pwp1_[a-f0-9]{64}$",
          "description": "Required authoritative PocketWorld profile digest; unknown/missing profile is rejected before authorization. See profile.json."
        }
      },
      "required": [
        "protocolVersion",
        "messageType",
        "inviteId",
        "inviterDeviceId",
        "inviterInstanceId",
        "inviterFingerprint",
        "joinerDeviceId",
        "joinerInstanceId",
        "joinerFingerprint",
        "tokenDigest",
        "expiresAt",
        "protocolProfile"
      ],
      "additionalProperties": false
    },
    "Confirmation": {
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "transcript": {
          "$ref": "#/$defs/Transcript"
        },
        "signature": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 200,
          "description": "Standard P-256/SHA-256 ECDSA ASN.1 DER signature over canonical transcript."
        }
      },
      "required": [
        "deviceId",
        "transcript",
        "signature"
      ],
      "additionalProperties": false
    },
    "Invitation": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "messageType": {
          "const": "PairingInvitation"
        },
        "inviteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "inviterDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "certificateDer": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 22000
        },
        "certificateFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "connectionHint": {
          "$ref": "#/$defs/ConnectionHint"
        },
        "protocolProfile": {
          "type": "string",
          "pattern": "^pwp1_[a-f0-9]{64}$",
          "description": "Required authoritative PocketWorld profile digest; unknown/missing profile is rejected before authorization. See profile.json."
        }
      },
      "required": [
        "protocolVersion",
        "messageType",
        "inviteId",
        "inviterDeviceId",
        "instanceId",
        "certificateDer",
        "certificateFingerprint",
        "token",
        "expiresAt",
        "protocolProfile"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "messageType": {
          "const": "PairingCandidate"
        },
        "inviteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "joinerCertificateDer": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 11000
        },
        "joinerInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "protocolProfile": {
          "type": "string",
          "pattern": "^pwp1_[a-f0-9]{64}$",
          "description": "Required authoritative PocketWorld profile digest; unknown/missing profile is rejected before authorization. See profile.json."
        }
      },
      "required": [
        "protocolVersion",
        "messageType",
        "inviteId",
        "token",
        "joinerCertificateDer",
        "joinerInstanceId",
        "confirmation",
        "protocolProfile"
      ],
      "additionalProperties": false
    },
    "CommittedReceipt": {
      "type": "object",
      "properties": {
        "inviteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "peerDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "authorizationEpoch": {
          "const": 1
        },
        "grantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "localConfirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "status": {
          "const": "paired"
        },
        "commitReceipt": {
          "$ref": "#/$defs/CommitReceipt"
        }
      },
      "required": [
        "inviteId",
        "peerDeviceId",
        "authorizationEpoch",
        "localConfirmation",
        "status",
        "grantId",
        "commitReceipt"
      ],
      "additionalProperties": false
    },
    "CandidateReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "messageType": {
          "const": "PairingCandidateReceipt"
        },
        "inviteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "candidateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inviterDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "joinerDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "pending_owner_confirmation",
            "confirmed_for_mtls",
            "paired",
            "rejected"
          ]
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "pairingReceipt": {
          "$ref": "#/$defs/CommittedReceipt"
        },
        "currentlyTrusted": {
          "type": "boolean"
        },
        "protocolProfile": {
          "type": "string",
          "pattern": "^pwp1_[a-f0-9]{64}$",
          "description": "Required authoritative PocketWorld profile digest; unknown/missing profile is rejected before authorization. See profile.json."
        }
      },
      "required": [
        "protocolVersion",
        "messageType",
        "inviteId",
        "candidateDigest",
        "inviterDeviceId",
        "joinerDeviceId",
        "expiresAt",
        "state",
        "protocolProfile"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "confirmed_for_mtls"
              }
            }
          },
          "then": {
            "required": [
              "confirmation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "paired"
              }
            }
          },
          "then": {
            "required": [
              "pairingReceipt",
              "currentlyTrusted"
            ]
          }
        }
      ]
    },
    "Finalize": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "messageType": {
          "const": "PairingFinalize"
        },
        "inviteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "candidateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "protocolProfile": {
          "type": "string",
          "pattern": "^pwp1_[a-f0-9]{64}$",
          "description": "Required authoritative PocketWorld profile digest; unknown/missing profile is rejected before authorization. See profile.json."
        },
        "purpose": {
          "enum": [
            "commit",
            "recover"
          ],
          "description": "commit requires live native PendingPairing and original TTL; recover requires native CommittedPairingRecovery for the same already-consumed SQL transaction."
        }
      },
      "required": [
        "protocolVersion",
        "messageType",
        "inviteId",
        "candidateDigest",
        "protocolProfile",
        "purpose"
      ],
      "additionalProperties": false
    },
    "GrantReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "messageType": {
          "const": "PairGrantReceipt"
        },
        "issuerDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "issuerCertificateFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "body": {
          "type": "object",
          "properties": {
            "grant": {
              "$ref": "urn:pocketworld:device:1.0#/$defs/PairGrant"
            },
            "targetInstanceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "issuedAt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "grant",
            "targetInstanceId",
            "issuedAt"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 200
        },
        "protocolProfile": {
          "type": "string",
          "pattern": "^pwp1_[a-f0-9]{64}$",
          "description": "Required authoritative PocketWorld profile digest; unknown/missing profile is rejected before authorization. See profile.json."
        }
      },
      "required": [
        "protocolVersion",
        "messageType",
        "issuerDeviceId",
        "issuerCertificateFingerprint",
        "body",
        "signature",
        "protocolProfile"
      ],
      "additionalProperties": false
    },
    "Completion": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "messageType": {
          "const": "PairingCompletion"
        },
        "inviteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "candidateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executorDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "pairingReceipt": {
          "$ref": "#/$defs/CommittedReceipt"
        },
        "grantReceipt": {
          "$ref": "#/$defs/GrantReceipt"
        },
        "protocolProfile": {
          "type": "string",
          "pattern": "^pwp1_[a-f0-9]{64}$",
          "description": "Required authoritative PocketWorld profile digest; unknown/missing profile is rejected before authorization. See profile.json."
        }
      },
      "required": [
        "protocolVersion",
        "messageType",
        "inviteId",
        "candidateDigest",
        "executorDeviceId",
        "instanceId",
        "pairingReceipt",
        "grantReceipt",
        "protocolProfile"
      ],
      "additionalProperties": false
    },
    "ConnectionHint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "lan"
            },
            "host": {
              "type": "string",
              "maxLength": 64
            },
            "candidatePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "completionPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "controlPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "bulkPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "host",
            "candidatePort",
            "completionPort",
            "controlPort",
            "bulkPort"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "relay"
            },
            "serviceBase": {
              "type": "string",
              "maxLength": 512
            },
            "inviterDeviceId": {
              "type": "string",
              "pattern": "^pw1_[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "serviceBase",
            "inviterDeviceId"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Routing metadata only: native validates IP literal, distinct lane ports, exact locally configured TLS relay base and invitation inviter identity; never adds credentials or trust."
    },
    "CommitReceipt": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "messageType": {
          "const": "PairingCommitReceipt"
        },
        "issuerDeviceId": {
          "type": "string",
          "pattern": "^pw1_[a-f0-9]{64}$"
        },
        "issuerCertificateFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "body": {
          "type": "object",
          "properties": {
            "commitId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "committedAt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "inviteId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "transcriptDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "grantDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA256 of PocketWorld canonical original receiving PairGrant with the separately fenced revoked flag omitted; no other field omitted."
            },
            "grantId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "authorizationEpoch": {
              "const": 1
            },
            "inviterDeviceId": {
              "type": "string",
              "pattern": "^pw1_[a-f0-9]{64}$"
            },
            "inviterInstanceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "inviterFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "joinerDeviceId": {
              "type": "string",
              "pattern": "^pw1_[a-f0-9]{64}$"
            },
            "joinerInstanceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "joinerFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "commitId",
            "committedAt",
            "inviteId",
            "transcriptDigest",
            "grantDigest",
            "grantId",
            "authorizationEpoch",
            "inviterDeviceId",
            "inviterInstanceId",
            "inviterFingerprint",
            "joinerDeviceId",
            "joinerInstanceId",
            "joinerFingerprint"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 200
        },
        "protocolProfile": {
          "type": "string",
          "pattern": "^pwp1_[a-f0-9]{64}$",
          "description": "Required authoritative PocketWorld profile digest; unknown/missing profile is rejected before authorization. See profile.json."
        }
      },
      "required": [
        "protocolVersion",
        "messageType",
        "issuerDeviceId",
        "issuerCertificateFingerprint",
        "body",
        "signature",
        "protocolProfile"
      ],
      "additionalProperties": false
    }
  },
  "x-limits": {
    "candidate_control_max_bytes": 16384,
    "finalize_max_bytes": 4096,
    "native_initial_grant_max_bytes": 8192,
    "invite_max_ttl_ms": 300000,
    "new_signature_checks_per_invite": 8,
    "active_candidates": 8,
    "pending_invitations": 32
  },
  "x-authority": "Candidate/receipt/JSON fingerprints are not business authority; use native typed owner confirmation and actual mTLS authenticated peer. A persisted confirmed boolean/signature cannot resurrect a PendingPairing after process death; owner reconfirms. Both endpoints require immutable native exact PairGrant-scope review in addition to both fingerprints; pin-only confirmation cannot commit a grant. Receiver confirmationRevision fences superseded reviews; SQL-confirmed alone cannot reconstruct a PendingPairing."
}
