{
  "id": "dev.example.text",
  "name": "Local text tools",
  "version": "1.0",
  "tools": [{
    "name": "normalize_text",
    "kind": "http",
    "description": "Normalize whitespace with the explicitly started local development server",
    "endpoint": "http://127.0.0.1:8765/tools",
    "effect": "read",
    "schema": {
      "type": "object",
      "properties": {"text": {"type": "string", "maxLength": 4000}},
      "required": ["text"],
      "additionalProperties": false
    }
  }, {
    "name": "word_count",
    "kind": "http",
    "description": "Count actual whitespace-delimited words in the supplied text",
    "endpoint": "http://127.0.0.1:8765/tools",
    "effect": "read",
    "schema": {
      "type": "object",
      "properties": {"text": {"type": "string", "maxLength": 4000}},
      "required": ["text"],
      "additionalProperties": false
    }
  }]
}
